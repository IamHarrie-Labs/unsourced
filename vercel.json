{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "unsourced.vercel.app" }],
      "destination": "https://www.unsourced.xyz/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "unsourced.vercel.app" }],
      "destination": "https://www.unsourced.xyz/:path*",
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
